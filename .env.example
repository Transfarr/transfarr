# Match the UID/GID that owns ./volumes/data and ./volumes/mnt.
PUID=1000
PGID=1000
TRANSFARR_UMASK=0022
# Set this to the host's reachable IP or DNS name for passive FTP/FTPS.
TRANSFARR_PUBLIC_HOST=127.0.0.1
# Standard protocol ports on the host network. Each port must be available.
# Initial protocol ports; saved Settings values take precedence.
TRANSFARR_SMB_PORT=445
TRANSFARR_FTP_PORT=21
TRANSFARR_FTPS_PORT=990
TRANSFARR_SFTP_PORT=22
# Initial passive ranges: FTP uses this port through +9; FTPS uses +10 through +19.
# Saved FTP/FTPS ranges in Settings take precedence.
TRANSFARR_PASSIVE_MIN=50000
